import React from "react";
import "./model.scss";
import { KeyWithAnyModel, StoreModel } from "../../../utils/model/common-model";
import { useDispatch, useSelector } from "react-redux";
import { errorAction } from "../../../utils/store/error-slice";
import {
  dispatchLoader,
  redirectingToIbanking,
} from "../../../services/common-service";
import DOMPurify from "dompurify";
import { getUrl } from "../../../utils/common/change.utils";
import { Player } from "@lottiefiles/react-lottie-player";
import lottieSrc from "../../../assets/_json/lottie/oops.json";

const DynamicModel = (props: KeyWithAnyModel) => {
  const modelData = props.errorList;
  const stageSelector = useSelector((state: StoreModel) => state.stages.stages);
  const dispatch = useDispatch();
  const handlebuttonClick = () => {
    if (props.errorList.error_type === "CancelApplication" || props.errorList.error_type === "cancelResume") {
      if (
        (getUrl.getParameterByName("SSCode") || (getUrl.getUpdatedStage().SScode != null && getUrl.getUpdatedStage().SScode !== "")|| getUrl.getParameterByName('transfer-token') ||  getUrl.getUpdatedStage().ccplChannel=== "IBK" || getUrl.getUpdatedStage().ccplChannel=== "MBNK") || 
        (stageSelector && stageSelector[0] && stageSelector[0].stageInfo  && 
          stageSelector[0].stageInfo.applicants && (stageSelector[0].stageInfo.applicants["auth_mode_a_1"] === "IX" || stageSelector[0].stageInfo.applicants["auth_mode_a_1"] === "IM"))
      ) {
        if (getUrl.getParameterByName("source") === "scm") {
          //Ibanking redirection for app
          window.location.href = `${process.env.REACT_APP_IBANKING_SC_MOBILE}`;
        } else if(getUrl.getUpdatedStage().ccplChannel=== "MBNK" || getUrl.getParameterByName("channel") === "MBNK") {
          const redirectUrl =  `${process.env.REACT_APP_IBANKING_SC_MOBILE_TRANSFER}`;
          window.location.href = redirectUrl;
        } else {
          redirectingToIbanking();
        }
      } else {
        if(props.errorList.error_type === "cancelResume"){
          window.location.href = `${process.env.REACT_APP_RESUME_URL}`;
        }else{
          window.location.href = `${process.env.REACT_APP_HOME_PAGE_URL}`;
        }
      }
    } else if (props.handlebuttonClick) {
      props.handlebuttonClick();
    } else {
      dispatch(dispatchLoader(false));
      dispatch(errorAction.getExceptionList([]));
    }
  };

  const getMarkup = (content: any) => {
    return {
      __html: DOMPurify.sanitize(content),
    };
  };

  return (
    <>
      {modelData && modelData && (
        <div className="popup">
          <div className="popup__container">
            <div className="waring__icon">
              <Player src={lottieSrc} className="player" loop autoplay />
            </div>
            <div className="popup__info">
              {modelData.error_header && (
                <>
                  {modelData.errorList &&
                    modelData.errorList.application_reference && (
                      <div className="app__ref">
                        APPLICATION NO:{" "}
                        {modelData.errorList.application_reference}
                      </div>
                    )}
                  <div className="popup__info__head">
                    {modelData.error_header}
                  </div>
                </>
              )}
              <div className="popup__info__desc">
                {modelData.errorList.errors.map(
                  (content: KeyWithAnyModel, index: number) => {
                    return (
                      <p key={`${content}${index}`}>
                        {content.detail ? (
                          <span
                            dangerouslySetInnerHTML={getMarkup(content.detail)}
                          />
                        ) : (
                          "Something went wrong!"
                        )}
                      </p>
                    );
                  }
                )}
                {modelData.error_button && (
                  <p
                    className="btn"
                    onClick={() => handlebuttonClick()}
                    key={`${modelData.error_button}`}
                  >
                    {modelData.error_button}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      )}
    </>
  );
};

export default DynamicModel;


import React from "react";
import { render, screen, fireEvent } from "@testing-library/react";
import { Provider } from "react-redux";
import configureStore from "redux-mock-store";
import DynamicModel from "../dynamic-model";
import { errorAction } from "../../../utils/store/error-slice";
import { dispatchLoader, redirectingToIbanking } from "../../../services/common-service";

jest.mock("../../../utils/store/error-slice", () => ({
  errorAction: {
    getExceptionList: jest.fn(),
  },
}));

jest.mock("../../../services/common-service", () => ({
  dispatchLoader: jest.fn(),
  redirectingToIbanking: jest.fn(),
}));

jest.mock("../../../utils/common/change.utils", () => ({
  getUrl: {
    getParameterByName: jest.fn((param) => (param === "source" ? "scm" : null)),
    getUpdatedStage: jest.fn(() => ({
      SScode: "1234",
      ccplChannel: "MBNK",
    })),
  },
}));

const mockStore = configureStore([]);

describe("DynamicModel Component", () => {
  let store: any;
  const mockHandleClick = jest.fn();

  beforeEach(() => {
    store = mockStore({
      stages: {
        stages: [
          {
            stageInfo: {
              applicants: {
                auth_mode_a_1: "IX",
              },
            },
          },
        ],
      },
    });
  });

  const mockErrorList = {
    error_type: "CancelApplication",
    error_header: "Error Occurred",
    error_button: "Retry",
    errorList: {
      application_reference: "APP123",
      errors: [
        { detail: "<b>Test Error</b>" },
        { detail: "Another error occurred." },
      ],
    },
  };

  it("should render the DynamicModel component", () => {
    render(
      <Provider store={store}>
        <DynamicModel errorList={mockErrorList} />
      </Provider>
    );

    expect(screen.getByText(/Error Occurred/)).toBeInTheDocument();
    expect(screen.getByText(/APPLICATION NO: APP123/)).toBeInTheDocument();
    expect(screen.getByText(/Retry/)).toBeInTheDocument();
    expect(screen.getByText(/Another error occurred./)).toBeInTheDocument();
  });

  it("should sanitize and render error details", () => {
    render(
      <Provider store={store}>
        <DynamicModel errorList={mockErrorList} />
      </Provider>
    );

    const sanitizedContent = screen.getByText(/Test Error/);
    expect(sanitizedContent).toBeInTheDocument();
    expect(sanitizedContent.tagName).toBe("SPAN");
  });

  it("should handle error button click for CancelApplication", () => {
    render(
      <Provider store={store}>
        <DynamicModel errorList={mockErrorList} />
      </Provider>
    );

    const retryButton = screen.getByText(/Retry/);
    fireEvent.click(retryButton);

    expect(redirectingToIbanking).toHaveBeenCalled();
  });

  it("should handle error button click with cancelResume and redirect to RESUME_URL", () => {
    const mockErrorListCancelResume = { ...mockErrorList, error_type: "cancelResume" };
    render(
      <Provider store={store}>
        <DynamicModel errorList={mockErrorListCancelResume} />
      </Provider>
    );

    const retryButton = screen.getByText(/Retry/);
    fireEvent.click(retryButton);

    expect(window.location.href).toBe(process.env.REACT_APP_RESUME_URL);
  });

  it("should handle button click when handlebuttonClick prop is provided", () => {
    render(
      <Provider store={store}>
        <DynamicModel errorList={mockErrorList} handlebuttonClick={mockHandleClick} />
      </Provider>
    );

    const retryButton = screen.getByText(/Retry/);
    fireEvent.click(retryButton);

    expect(mockHandleClick).toHaveBeenCalled();
  });

  it("should dispatch loader and reset errors if no error type and no handlebuttonClick", () => {
    render(
      <Provider store={store}>
        <DynamicModel errorList={{ ...mockErrorList, error_type: null }} />
      </Provider>
    );

    const retryButton = screen.getByText(/Retry/);
    fireEvent.click(retryButton);

    expect(dispatchLoader).toHaveBeenCalledWith(false);
    expect(errorAction.getExceptionList).toHaveBeenCalledWith([]);
  });
});
